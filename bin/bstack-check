#!/usr/bin/env bash
# Validate a plugin's skills, agents, and cross-file references.
# Usage: bstack-check [plugin-root]   (default: the current git repo root; exits non-zero on failure)
set -uo pipefail
shopt -s nullglob

root="${1:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
cd "$root" || exit 1
fail=0
err() { printf 'FAIL %s\n' "$1"; fail=1; }

frontmatter_has() {
	awk 'NR==1 && $0!="---" {exit 1} NR>1 && $0=="---" {exit} NR>1' "$1" | grep -q "^$2:"
}

for f in skills/*/SKILL.md agents/*.md; do
	[ -e "$f" ] || continue
	for key in name description; do
		frontmatter_has "$f" "$key" || err "$f: frontmatter missing '$key'"
	done
done

# Every backticked relative path inside a skill resolves from that skill's directory.
for skill in skills/*/; do
	while IFS=: read -r file ref; do
		ref="${ref//\`/}"
		[ -e "$skill$ref" ] || err "$file: '$ref' does not exist (relative to $skill)"
	done < <(grep -roE '`(\.\./[a-z0-9-]+/)?(playbooks|principles|references|scripts)/[A-Za-z0-9._-]+`' "$skill" --include='*.md')
done

# The router's index and the files on disk match in both directions.
mode=skills/bstack-mode/SKILL.md
if [ -f "$mode" ]; then
	for dir in playbooks principles; do
		for f in skills/bstack-mode/$dir/*.md; do
			grep -q "\`$dir/$(basename "$f")\`" "$mode" || err "$f is not listed in $mode"
		done
	done
fi

# Prose rules the porting pass had to enforce by hand.
while IFS=: read -r file line _; do
	err "$file:$line: em or en dash, rewrite as two sentences or use a comma"
done < <(grep -rn '—\|–' skills/ agents/ --include='*.md' 2>/dev/null)

# A skill named in prose that does not exist sends the agent looking for nothing.
# The set of real names comes from disk, so this check maintains itself as skills are added.
shipped=" $(ls -d skills/*/ 2>/dev/null | xargs -n1 basename | tr '\n' ' ')"
# Claude Code ships these; naming one is legitimate.
builtin=" code-review security-review run loop init plan context compact resume export reload-plugins skill-doctor artifacts config "
while IFS=$'\t' read -r loc name; do
	case "$shipped$builtin" in
		*" $name "*) ;;
		*) err "${loc}: names the '$name' skill, which nothing ships. Use a real skill or describe the action." ;;
	esac
done < <(for f in $(find skills agents -name '*.md' 2>/dev/null); do
		# Blank out inline code spans first, so a shell command or a D-Bus path is never read as a skill name.
		sed 's/`[^`]*`/``/g' "$f" | grep -noE '\*\*[a-z][a-z-]+\*\* skill|(^|[ (])/[a-z][a-z-]+' |
			sed -E "s#^([0-9]+):#$f:\1\t#"
	done | sed -E 's#\t.*\*\*([a-z-]+)\*\* skill#\t\1#; s#\t.*/([a-z-]+)$#\t\1#')

claude plugin validate . >/dev/null 2>&1 || err "claude plugin validate failed (run it for details)"

[ "$fail" -eq 0 ] && echo "check: ok"
exit "$fail"
